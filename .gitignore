*.db
*.sqlite
*.sqlite3
*.mdb
*.accdb
*.dump
*.dump.sql
*_dump.sql
*-dump.sql
*.sql.gz
*.sql.zip

# Private keys and local credential stores
*.pem
*.key
*.p12
*.pfx
*.ppk
id_rsa
id_ed25519
credentials.json
credentials.yml
credentials.yaml
.aws/
.ssh/

# Existing IDE-specific exclusions
.idea/
.vscode/
