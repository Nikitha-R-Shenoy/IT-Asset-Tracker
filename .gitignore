# Local environment variables and secrets
.env
.env.*
!.env.example

# Virtual environments
.venv/
.venv-win/
venv/
env/

# Python-generated files and test/tool caches
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage*
htmlcov/
junit.xml
coverage.xml

# Local application data and generated files
instance/
*.log

# Local database files and compressed/dedicated database dumps.
