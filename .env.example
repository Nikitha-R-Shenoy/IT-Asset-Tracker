# Generate a random secret for each environment; never commit your populated .env file.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=mysql+pymysql://<user>:<password>@<host>/<database>
SESSION_COOKIE_SECURE=false

# Required only when running the initial administrator seed command.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
